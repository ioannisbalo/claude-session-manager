{
  "compilerOptions": {
    "target": "ES2020",
    // Was "none" (removed in TypeScript 7). Renderer files have no top-level
    // import/export, so they still emit as classic global scripts for <script> tags.
    "module": "preserve",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist/src/renderer",
    "rootDir": "src/renderer",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true
  },
  "include": ["src/renderer/**/*.ts"]
}
